<mujoco model="HardTrack">
  <!-- Converted from HardTrack's Webots PROTO by
       scripts/import_webots_track.py. Real-world size 9.47 x 8.72 m
       (the PROTO applies scale 7.5 7.5 7.5 to the raw mesh).
       Visual only -- contype/conaffinity 0 -- because a track is paint on the floor, not
       something to drive into. Group 3 so LineFollowerEnv's appearance
       randomization finds it and the viewers show it. -->
  <asset>
    <!-- inertia="shell": these meshes are perfectly flat, so MuJoCo's default volume-based
         inertia computation rejects them ("mesh volume is too small"). Shell inertia treats
         the mesh as a surface, which is what a painted track is. It never actually matters
         here -- the geom is static and visual-only -- but the compiler still validates it. -->
    <mesh name="HardTrack" file="../../objects/tracks/HardTrack.obj" inertia="shell"
          scale="7.5 7.5 7.5"/>
  </asset>
  <worldbody>
    <geom name="line_HardTrack" type="mesh" mesh="HardTrack" quat="1 0 0 0"
          pos="-2.9275 1.0839 0.002"
          contype="0" conaffinity="0" group="2" rgba="0.05 0.05 0.05 1"/>
  </worldbody>
</mujoco>
