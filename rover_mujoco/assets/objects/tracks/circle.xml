<mujoco model="circular_line_track">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture name="tex_track" type="2d" file="track_texture.png"/>
    <material name="mat_track" texture="tex_track" texuniform="true" texrepeat="1 1"
              specular="0.1" shininess="0.05" reflectance="0"/>
    <texture name="tex_sky" type="skybox" builtin="gradient" rgb1="0.85 0.9 1" rgb2="1 1 1" width="256" height="256"/>
  </asset>

  <worldbody>
    <light name="top_light" pos="0 0 2" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <camera name="overhead" pos="0 0 2.2" xyaxes="1 0 0 0 1 0"/>

    <!-- Floor with the black circular track baked into its texture -->
    <geom name="floor" type="plane" size="0.75 0.75 0.01" material="mat_track" condim="3"/>

  </worldbody>

</mujoco>
