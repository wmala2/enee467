<mujoco model="rover_arena_real">
  <!-- Pulls in the rover body/mesh/joint/camera/lidar-site tree compiled from rover.urdf -->
  <include file="rover.xml"/>
  <!-- Walled 5x5 m arena and its obstacle pool (generated by scripts/gen_arena.py) -->
  <include file="../../objects/arena/arena_5x5.xml"/>

  <!-- Implicit integrator: see docs/onshape-to-robot-mjcf.md for why this matters here -->
  <option integrator="implicitfast"/>

  <worldbody>
    <!-- Overhead light so the rover, obstacles and walls are visible in the viewer -->
    <light diffuse=".8 .8 .8" pos="0 0 3" dir="0 0 -1"/>
    <!-- Ground plane sized to the arena, not the default 10x10 rover_scene.xml floor -->
    <geom name="floor" type="plane" size="2.5 2.5 0.1" rgba=".8 .8 .8 1"/>
  </worldbody>

  <sensor>
    <!-- BEGIN generated lidar sensors (scripts/gen_rover_lidar.py) -->
    <!-- One rangefinder per lidar ray. Ordered left/centre/right to match the
         firmware's "l" reply, so the observation lines up field-for-field with what
         rover_control/encoder_poller.py's lidar_latest() returns on the real rover. -->
    <rangefinder name="range_left_0" site="lidar_left_0"/>
    <rangefinder name="range_left_1" site="lidar_left_1"/>
    <rangefinder name="range_left_2" site="lidar_left_2"/>
    <rangefinder name="range_left_3" site="lidar_left_3"/>
    <rangefinder name="range_left_4" site="lidar_left_4"/>
    <rangefinder name="range_center_0" site="lidar_center_0"/>
    <rangefinder name="range_center_1" site="lidar_center_1"/>
    <rangefinder name="range_center_2" site="lidar_center_2"/>
    <rangefinder name="range_center_3" site="lidar_center_3"/>
    <rangefinder name="range_center_4" site="lidar_center_4"/>
    <rangefinder name="range_right_0" site="lidar_right_0"/>
    <rangefinder name="range_right_1" site="lidar_right_1"/>
    <rangefinder name="range_right_2" site="lidar_right_2"/>
    <rangefinder name="range_right_3" site="lidar_right_3"/>
    <rangefinder name="range_right_4" site="lidar_right_4"/>
    <!-- END generated lidar sensors -->
  </sensor>

  <actuator>
    <!-- Raw torque actuators, matching the other *_real.xml scenes: ctrl is Nm, computed each
         step by envs/motor.py's JGA25-371 model rather than by a MuJoCo <velocity> servo. -->
    <motor name="left_wheel_motor" joint="left_axle" forcerange="-0.11 0.11"/>
    <motor name="right_wheel_motor" joint="right_axle" forcerange="-0.11 0.11"/>
  </actuator>
</mujoco>
