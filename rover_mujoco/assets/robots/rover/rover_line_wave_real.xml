<mujoco model="rover_line_wave_real">
  <!-- Pulls in the rover body/mesh/joint/camera tree compiled from rover.urdf -->
  <include file="rover.xml"/>
  <!-- Black line track (generated by scripts/gen_track.py) -->
  <include file="../../objects/tracks/track_wave.xml"/>

  <!-- Implicit integrator: see docs/onshape-to-robot-mjcf.md for why this matters here -->
  <!-- Offscreen framebuffer, only used for top-down renders and debugging; the
       policy's own 64x64 camera needs nothing this large. -->
  <visual>
    <global offwidth="960" offheight="640"/>
  </visual>

  <option integrator="implicitfast"/>

  <asset>
    <!-- Light skybox. Without this, everything above the horizon renders pure black, which is
         indistinguishable from a black line: the onboard camera's dark-pixel test locked onto
         the sky instead of the track, full width, so its centroid sat dead centre and the
         steering error was frozen at -0.016 no matter where the rover was. -->
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.75 0.80 0.86" rgb2="0.55 0.62 0.70" width="256" height="256"/>
  </asset>

  <worldbody>
    <!-- Overhead light so the rover and track are visible in the viewer -->
    <light diffuse=".8 .8 .8" pos="0 0 3" dir="0 0 -1"/>
    <!-- Ground plane sized to the track, not the default 10x10 rover_scene.xml floor -->
    <geom name="floor" type="plane" size="2 2 0.1" rgba=".8 .8 .8 1"/>
  </worldbody>

  <sensor>
    <!-- Declared so MuJoCo's viewer can plot them live (its sensor figure is empty unless the
         model has sensors). Wheel speeds are what you command; the base velocimeter is what
         the chassis actually does, which is the pair worth watching while tuning. -->
    <jointvel name="left_wheel_speed" joint="left_axle"/>
    <jointvel name="right_wheel_speed" joint="right_axle"/>
    <velocimeter name="base_velocity" site="base_imu"/>
  </sensor>

  <actuator>
    <!-- Raw torque actuator, unlike rover_line_wave.xml's <velocity> servo: ctrl here is
         Nm, computed each step by envs/motor.py's JGA25-371 DC-motor model rather than by
         MuJoCo's built-in velocity-servo dynamics. forcerange matches the motor's ~0.108 Nm
         datasheet stall torque as a safety bound (see envs/motor.py for the derivation). -->
    <motor name="left_wheel_motor" joint="left_axle" forcerange="-0.11 0.11"/>
    <motor name="right_wheel_motor" joint="right_axle" forcerange="-0.11 0.11"/>
  </actuator>
</mujoco>
