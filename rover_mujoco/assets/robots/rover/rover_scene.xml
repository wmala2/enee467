<mujoco model="rover_scene">
  <!-- Pulls in the rover body/mesh/joint tree compiled from rover.urdf -->
  <include file="rover.xml"/>

  <!-- Implicit integrator: handles the stiff coupling between the velocity actuators and the
       rover's very small wheel inertias far more robustly than the default explicit Euler -->
  <option integrator="implicitfast"/>

  <worldbody>
    <!-- Overhead light so the rover and floor are visible in the viewer -->
    <light diffuse=".8 .8 .8" pos="0 0 3" dir="0 0 -1"/>
    <!-- Ground plane the rover drives on -->
    <geom name="floor" type="plane" size="10 10 0.1" rgba=".8 .8 .8 1"/>
  </worldbody>

  <actuator>
    <!-- Velocity servo on left wheel: ctrl is a target angular speed (rad/s), self-damping and stable for teleop -->
    <velocity name="left_wheel_motor" joint="left_axle" kv="0.2" ctrlrange="-10 10"/>
    <!-- Velocity servo on right wheel: ctrl is a target angular speed (rad/s), self-damping and stable for teleop -->
    <velocity name="right_wheel_motor" joint="right_axle" kv="0.2" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
