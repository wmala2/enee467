diff --git a/rover_mujoco/assets/objects/tracks/SwingTrack.xml b/rover_mujoco/assets/objects/tracks/SwingTrack.xml
new file mode 100644
index 0000000..b21148e
--- /dev/null
+++ b/rover_mujoco/assets/objects/tracks/SwingTrack.xml
@@ -0,0 +1,21 @@
+<mujoco model="SwingTrack">
+  <!-- Converted from SwingTrack's Webots PROTO by
+       scripts/import_webots_track.py. Real-world size 0.95 x 0.72 m
+       (the PROTO applies scale 7.5 7.5 7.5 to the raw mesh).
+       Visual only -- contype/conaffinity 0 -- because a track is paint on the floor, not
+       something to drive into. Group 3 so LineFollowerEnv's appearance
+       randomization finds it and the viewers show it. -->
+  <asset>
+    <!-- inertia="shell": these meshes are perfectly flat, so MuJoCo's default volume-based
+         inertia computation rejects them ("mesh volume is too small"). Shell inertia treats
+         the mesh as a surface, which is what a painted track is. It never actually matters
+         here -- the geom is static and visual-only -- but the compiler still validates it. -->
+    <mesh name="SwingTrack" file="../../objects/tracks/SwingTrack.obj" inertia="shell"
+          scale="7.5 7.5 7.5"/>
+  </asset>
+  <worldbody>
+    <geom name="SwingTrack" type="mesh" mesh="SwingTrack" quat="1 0 0 0"
+          pos="-0.0205 0.0333 0.002"
+          contype="0" conaffinity="0" group="3" rgba="0.05 0.05 0.05 1"/>
+  </worldbody>
+</mujoco>
