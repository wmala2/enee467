diff --git a/rover_mujoco/assets/robots/rover/rover_CircleTrack.xml b/rover_mujoco/assets/robots/rover/rover_CircleTrack.xml
new file mode 100644
index 0000000..c89b38f
--- /dev/null
+++ b/rover_mujoco/assets/robots/rover/rover_CircleTrack.xml
@@ -0,0 +1,35 @@
+<mujoco model="rover_CircleTrack">
+  <!-- Rover body/mesh/joint/camera tree compiled from rover.urdf -->
+  <include file="rover.xml"/>
+  <!-- Track converted from the Webots PROTO by scripts/import_webots_track.py -->
+  <include file="../../objects/tracks/CircleTrack.xml"/>
+
+  <option integrator="implicitfast"/>
+
+  <asset>
+    <!-- Light skybox. Without this, everything above the horizon renders pure black, which is
+         indistinguishable from a black line: the onboard camera's dark-pixel test locked onto
+         the sky instead of the track, full width, so its centroid sat dead centre and the
+         steering error was frozen at -0.016 no matter where the rover was. -->
+    <texture name="skybox" type="skybox" builtin="gradient"
+             rgb1="0.75 0.80 0.86" rgb2="0.55 0.62 0.70" width="256" height="256"/>
+  </asset>
+
+  <worldbody>
+    <light diffuse=".8 .8 .8" pos="0 0 3" dir="0 0 -1"/>
+    <geom name="floor" type="plane" size="6 6 0.1" rgba=".8 .8 .8 1"/>
+  </worldbody>
+
+  <sensor>
+    <!-- Declared so MuJoCo's viewer can plot them live, and so read_telemetry() works on every
+         track scene rather than only the generated ones. -->
+    <jointvel name="left_wheel_speed" joint="left_axle"/>
+    <jointvel name="right_wheel_speed" joint="right_axle"/>
+    <velocimeter name="base_velocity" site="base_imu"/>
+  </sensor>
+
+  <actuator>
+    <velocity name="left_wheel_motor" joint="left_axle" kv="0.2" ctrlrange="-10 10"/>
+    <velocity name="right_wheel_motor" joint="right_axle" kv="0.2" ctrlrange="-10 10"/>
+  </actuator>
+</mujoco>
